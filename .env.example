# Mock mode requires no configuration. Copy to .env for real mode; never commit .env.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=
OPENAI_TEMPERATURE=0.1
# json_object (default) or text for providers without JSON mode; no automatic fallback.
OPENAI_JSON_MODE=json_object
OPENAI_TIMEOUT=30
# DeepSeek official configuration (choose manually; keep your actual key only in .env):
# OPENAI_BASE_URL=https://api.deepseek.com
# OPENAI_MODEL=deepseek-flash
